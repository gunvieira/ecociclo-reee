# Porta do servidor Express
PORT=3333

# Segredo usado para assinar tokens no modo local de desenvolvimento
LOCAL_AUTH_SECRET=ecociclo-reee-dev-secret-change-in-production

# URL permitida no CORS (Frontend Vite)
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# CONFIGURAÇÃO DO FIREBASE ADMIN (OPCIONAL NO DESENVOLVIMENTO INICIAL)
# Enquanto os campos abaixo estiverem vazios, a API usa automaticamente o
# banco local em backend/data/db.json para permitir testes imediatos.
# Quando preencher os 3 campos, o sistema passa a gravar no Firestore real!
# ============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
